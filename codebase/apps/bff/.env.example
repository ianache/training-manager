# --- Desarrollo local. En QA/PROD los secretos vienen de Vault (ADR-004), no de este archivo. ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Origen público del portal (el shell). El BFF redirige aquí tras login/logout.
PUBLIC_ORIGIN=http://localhost:4200

# Keycloak (ADR-005 §3: docker-compose en local; oauth2.qa/prod.comsatel.com.pe en QA/PROD).
# Local: issuer público http://localhost:8080 (el mismo que ve el navegador).
OIDC_ISSUER=http://localhost:8080/realms/gestion-formacion
OIDC_CLIENT_ID=bff-app
OIDC_CLIENT_SECRET=bff-dev-secret-change-me
# Debe estar registrada en el cliente de Keycloak. Pasa por el proxy del shell.
OIDC_REDIRECT_URI=http://localhost:4200/auth/callback
# Opcional: origen interno para llamadas BFF→Keycloak si difiere del issuer público
OIDC_INTERNAL_URL=

# Sesión (ADR-005 §5: 30 minutos)
SESSION_SECRET=change-me-at-least-32-characters-long
SESSION_TTL_SECONDS=1800
REDIS_URL=redis://:redis_password@localhost:6379

# Microservicios de dominio
PARTY_SERVICE_URL=http://localhost:8000
# Vacío = el catálogo responde 503 (servicio aún no construido)
CATALOG_SERVICE_URL=
DOWNSTREAM_TIMEOUT_MS=5000

# Vault (ADR-004). Si VAULT_ADDR está vacío (solo desarrollo) se usan OIDC_CLIENT_SECRET,
# SESSION_SECRET y REDIS_URL de arriba. En producción son obligatorios desde Vault:
#   vault kv put secret/gestion-formacion/auth/keycloak client_secret=...
#   vault kv put secret/gestion-formacion/bff session_secret=... redis_url=redis://:...@redis:6379
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
VAULT_BASE_PATH=gestion-formacion
