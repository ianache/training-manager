{
  "name": "portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve shell",
    "build": "npm run build:libs && ng build shell && ng build mfe-catalog && ng build mfe-collaborators",
    "watch": "ng build --watch --configuration development",
    "test": "ng test core && ng test shell && npm run test:collaborators",
    "test:collaborators": "ng test mfe-collaborators --watch=false --include=\"**/register-collaborator/*.spec.ts\"",
    "start:catalog": "ng serve mfe-catalog",
    "start:collaborators": "ng serve mfe-collaborators",
    "start:all": "npm-run-all --parallel start:catalog start:collaborators start",
    "build:libs": "ng build core && ng build ui",
    "lint:arch": "node tools/check-architecture.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "es-module-shims": "^2.8.0"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "^22.2.1",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "@softarc/native-federation-orchestrator": "^4.6.0",
    "npm-run-all2": "^8.0.0"
  }
}