    {
      "name": "7. Get Party by ID (Happy Path)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Party has correct ID', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.equal(pm.environment.get('party_id'));",
              "});",
              "pm.test('Party data is complete', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.first_names).to.exist;",
              "    pm.expect(jsonData.email_work).to.exist;",
              "    pm.expect(jsonData.status).to.equal('active');",
              "});"
            ]
          }
        }
      ],
