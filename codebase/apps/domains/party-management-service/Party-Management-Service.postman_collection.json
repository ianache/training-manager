{
  "info": {
    "name": "Party Management Service - Phase 1a Testing",
    "description": "Complete test collection for PARTY endpoints (POST, GET, GET/{id}, PATCH)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Happy Path - Create Party",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Response has party ID', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.exist;",
              "    pm.environment.set('party_id', jsonData.id);",
              "});",
              "pm.test('Response has all required fields', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.first_names).to.equal('Juan');",
              "    pm.expect(jsonData.last_names).to.equal('Pérez');",
              "    pm.expect(jsonData.email_work).to.equal('juan.perez@company.com');",
              "    pm.expect(jsonData.party_type).to.equal('Employee');",
              "    pm.expect(jsonData.status).to.equal('active');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session=jefe.valid.token"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_names\": \"Juan\",\n  \"last_names\": \"Pérez\",\n  \"preferred_name\": \"Juan Carlos\",\n  \"identification_type\": \"DNI\",\n  \"identification_number\": \"12345678\",\n  \"identification_country\": \"CO\",\n  \"email_work\": \"juan.perez@company.com\",\n  \"phone_work\": \"+57301234567\",\n  \"party_type\": \"Employee\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/api/v1/parties",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "v1", "parties"]
        }
      }
    },
