# Base de datos (ADR-003; en docker-compose: usuario gestion_user, sin superusuario)
DATABASE_URL=postgresql+asyncpg://gestion_user:gestion_password@localhost:5432/gestion_formacion
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=30

# Confianza en el BFF (ADR-005 §2)
# Issuer tal como aparece en el claim `iss` (público) y JWKS por la red interna.
KEYCLOAK_ISSUER=http://localhost:8080/realms/gestion-formacion
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/gestion-formacion/protocol/openid-connect/certs
KEYCLOAK_ALLOWED_CLIENTS=bff-app
AUTH_LEEWAY_SECONDS=30

# Servicio
API_HOST=0.0.0.0
API_PORT=8000
API_ENVIRONMENT=development
SEED_DEMO_DATA=false
LOG_LEVEL=INFO

# Límite de solicitudes por usuario (API-SPEC-001 §4.5). Producción: RATE_LIMIT_READ_PER_HOUR=10000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_READ_PER_HOUR=1000
RATE_LIMIT_CREATE_PER_HOUR=100
RATE_LIMIT_UPDATE_PER_HOUR=500
