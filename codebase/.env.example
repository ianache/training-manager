# Copiar como codebase/.env para sobrescribir las credenciales de desarrollo del docker-compose.
# NO usar estos valores fuera de la máquina local. En QA/PROD los secretos viven en Vault (ADR-004).

POSTGRES_PASSWORD=postgres
APP_DB_PASSWORD=gestion_password
KEYCLOAK_DB_PASSWORD=keycloak_password
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PASSWORD=gestion_password
REDIS_PASSWORD=redis_password

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

VAULT_DEV_ROOT_TOKEN=dev-root-token

# Debe coincidir con el "secret" del cliente bff-app en infra/keycloak/realm-gestion-formacion.json
BFF_OIDC_CLIENT_SECRET=bff-dev-secret-change-me
# Mínimo 32 caracteres
BFF_SESSION_SECRET=dev-session-secret-please-change-0123456789

# Organización interna (migración 0006 del servicio de party, DTC-017). Obligatorias en el primer arranque.
# INTERNAL_ORG_NAME=<razón social de COMSATEL>
# INTERNAL_ORG_RUC=<RUC de 11 dígitos>
